# Windows version to install (see https://github.com/dockur/windows#how-do-i-select-the-windows-version)
# 11 = Windows 11 Pro, 11l = Windows 11 LTSC, 10 = Windows 10 Pro, 2022 = Server 2022, etc.
VERSION=11
# Windows account (created during install, local administrator)
WIN_USERNAME=Docker
WIN_PASSWORD=admin
# VM resources
RAM_SIZE=8G
CPU_CORES=4
DISK_SIZE=64G
# Host ports
WEB_PORT=8006
# Guacamole web RDP client (http://127.0.0.1:GUAC_PORT). Login with GUAC_USER / GUAC_PASSWORD.
GUAC_PORT=8080
GUAC_USER=admin
GUAC_PASSWORD=admin
RDP_PORT=3389
SSH_PORT=2222
# Raw QEMU VNC display for virt-viewer / remote-viewer (see wire-with-virt-machine-manager.sh).
# Bound to localhost only; set VNC_BIND=0.0.0.0 to expose it on the LAN (no password on it!).
VNC_PORT=5900
VNC_BIND=127.0.0.1
